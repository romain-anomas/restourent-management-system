# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_management

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Client
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_PATH=uploads

# Default admin (used only by seed script)
SEED_ADMIN_EMAIL=admin@restaurant.com
SEED_ADMIN_PASSWORD=Admin@12345

# MTN Mobile Money (MoMo) Collections API - optional
# Get MOMO_SUBSCRIPTION_KEY from https://momodeveloper.mtn.com (your subscription's "Primary key")
# Then run `npm run momo:setup` to generate MOMO_API_USER / MOMO_API_KEY automatically.
# Leave these blank to disable automatic MoMo payment prompts (customers can still
# select MoMo at checkout - staff will just mark payments as paid manually instead).
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_CALLBACK_HOST=example.com

# Flutterwave card checkout (Rwanda supports card payments in RWF).
# Create a Flutterwave account, then set its secret key and webhook secret hash.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
